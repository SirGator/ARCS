{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "arcs.action.report_emit.v1",
  "type": "object",
  "required": ["action_id", "type", "option_ref", "policy_ref", "action_candidate_ref", "approval_ref", "verification_ref", "params", "required_permissions", "safety_level", "idempotency_key"],
  "properties": {
    "action_id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "const": "report_emit"
    },
    "option_ref": {
      "type": "object",
      "required": ["artifact_id", "version_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "policy_ref": {
      "type": "object",
      "required": ["artifact_id", "version_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "action_candidate_ref": {
      "type": "object",
      "required": ["artifact_id", "version_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "approval_ref": {
      "type": "object",
      "required": ["artifact_id", "version_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "verification_ref": {
      "type": "object",
      "required": ["artifact_id", "version_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "required": ["format"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["json", "md", "pdf"]
        },
        "sections": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "required_permissions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safety_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "idempotency_key": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
