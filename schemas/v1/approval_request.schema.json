{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "arcs.approval_request.v1",
  "type": "object",
  "required": ["target_option", "policy_ref", "verification_ref", "action_candidate_ref", "requested_scope", "requested_at", "store_head_at_request", "risk_summary"],
  "properties": {
    "target_option": {
      "type": "object",
      "required": ["artifact_id", "version_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "policy_ref": {
      "type": "object",
      "required": ["artifact_id", "version_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "verification_ref": {
      "type": "object",
      "required": ["artifact_id", "version_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "action_candidate_ref": {
      "type": "object",
      "required": ["artifact_id", "version_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "requested_scope": { "type": "string", "minLength": 1 },
    "requested_at": { "type": "string", "format": "date-time" },
    "store_head_at_request": { "type": "string", "minLength": 1 },
    "risk_summary": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
