{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "arcs.execution_command.v1",
  "type": "object",
  "required": ["command_id", "action_id", "type", "action_type", "target_adapter", "action_ref", "params", "required_permissions", "safety_level", "idempotency_key"],
  "properties": {
    "command_id": { "type": "string", "minLength": 1 },
    "action_id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "action_type": { "type": "string", "minLength": 1 },
    "target_adapter": { "type": "string", "minLength": 1 },
    "action_ref": {
      "type": "object",
      "required": ["artifact_id", "version_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "approval_ref": {
      "type": "object",
      "required": ["artifact_id", "version_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "verification_ref": {
      "type": "object",
      "required": ["artifact_id", "version_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "params": { "type": "object" },
    "required_permissions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safety_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "idempotency_key": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
