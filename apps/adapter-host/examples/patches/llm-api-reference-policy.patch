new file mode 100644
index 0000000..2532754
--- /dev/null
+++ b/llm_api/references.py
@@ -0,0 +1,60 @@
+"""Explicit transport provenance from supplied context, never semantic verdicts."""
+import copy
+import re
+
+
+def validate_fields(profile):
+    bindings = profile.get("context_reference_fields", {})
+    if not isinstance(bindings, dict) or len(bindings) > 16:
+        raise ValueError("Invalid context reference fields")
+    if bindings and profile.get("reference_policy") != "context":
+        raise ValueError("Context reference fields require reference_policy context")
+    for schema_id, fields in bindings.items():
+        schema = profile["target_schemas"].get(schema_id)
+        if not schema or not isinstance(fields, dict) or not 1 <= len(fields) <= 16:
+            raise ValueError("Invalid reference binding schema")
+        for field, pointers in fields.items():
+            definition = schema.get("properties", {}).get(field, {})
+            if (not isinstance(field, str) or not field or len(field) > 128
+                    or definition.get("type") != "array" or definition.get("items", {}).get("type") != "string"
+                    or not isinstance(pointers, list) or not 1 <= len(pointers) <= 8
+                    or any(not isinstance(p, str) or not p.startswith("/constraints/") or len(p) > 512
+                           or re.search(r"~(?![01])", p) for p in pointers)):
+                raise ValueError("Bindings only support declared reference arrays and constraint pointers")
+
+
+def prepare(profile, invocation):
+    """Remove only explicitly bound metadata fields from the model's schema.
+
+    Their values must be exact versions already in context. The model still
+    produces every semantic field, including effect, goal status and actions.
+    """
+    schema = copy.deepcopy(profile["target_schemas"][invocation["target_schema_id"]])
+    bound = {}
+    versions = {item["version_id"] for item in invocation["context"]}
+    for field, pointers in profile.get("context_reference_fields", {}).get(invocation["target_schema_id"], {}).items():
+        values = []
+        for pointer in pointers:
+            value = invocation
+            try:
+                for part in pointer.split("/")[1:]:
+                    value = value[part.replace("~1", "/").replace("~0", "~")]
+            except (KeyError, TypeError):
+                raise ValueError("Missing reference binding input") from None
+            items = list(value.values()) if isinstance(value, dict) else value if isinstance(value, list) else [value]
+            for item in items:
+                if not isinstance(item, str) or item not in versions:
+                    raise ValueError("Reference binding points outside supplied context")
+                if item not in values:
+                    values.append(item)
+        definition = schema["properties"][field]
+        if len(values) < definition.get("minItems", 0) or len(values) > definition.get("maxItems", len(versions)):
+            raise ValueError("Reference binding violates target cardinality")
+        allowed = definition.get("items", {}).get("enum")
+        if allowed is not None and any(item not in allowed for item in values):
+            raise ValueError("Reference binding violates target enum")
+        bound[field] = values
+        del schema["properties"][field]
+        if field in schema.get("required", []):
+            schema["required"].remove(field)
+    return schema, bound
