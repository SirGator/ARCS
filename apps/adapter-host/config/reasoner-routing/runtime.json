{
  "config_version": 1,
  "runtime_id": "reasoner-routing",
  "journal": "../../../../var/reasoner-routing/runtime.sqlite",
  "interval_ms": 100,
  "max_events_per_tick": 1000,
  "max_jobs_per_tick": 10,
  "max_pending_jobs": 100,
  "routes": [
    {
      "id": "occupy-analysis-slot",
      "source": {
        "adapter_id": "example.input",
        "capability_id": "task.submit"
      },
      "input_schema_id": "arcs.task.nearest.v1",
      "payload_fields": [
        "values",
        "target"
      ],
      "reasoner": {
        "adapter_id": "example.holder",
        "capability_id": "solution.propose"
      },
      "method": "solver",
      "objective": "Find the nearest listed value to the target",
      "target_schema_id": "arcs.solution_candidate.nearest.v1",
      "allowed_capabilities": [],
      "constraints": {},
      "budget": {
        "max_context_items": 1,
        "max_context_bytes": 8192,
        "max_output_bytes": 4096,
        "max_candidates": 1,
        "max_runtime_ms": 1000,
        "max_iterations": 4096,
        "max_output_tokens": null
      }
    },
    {
      "id": "choose-available-reasoner",
      "source": {
        "adapter_id": "example.input",
        "capability_id": "task.submit"
      },
      "input_schema_id": "arcs.task.nearest.v1",
      "payload_fields": [
        "values",
        "target"
      ],
      "reasoner": {
        "adapter_id": "example.solver",
        "capability_id": "solution.propose"
      },
      "method": "solver",
      "objective": "Find the nearest listed value to the target",
      "target_schema_id": "arcs.solution_candidate.nearest.v1",
      "allowed_capabilities": [],
      "constraints": {},
      "budget": {
        "max_context_items": 1,
        "max_context_bytes": 8192,
        "max_output_bytes": 4096,
        "max_candidates": 1,
        "max_runtime_ms": 1000,
        "max_iterations": 4096,
        "max_output_tokens": null
      },
      "reasoner_selection": {
        "alternatives": [
          {
            "capability": {
              "adapter_id": "example.model-fixture",
              "capability_id": "solution.propose"
            },
            "method": "learned",
            "budget": {
              "max_context_items": 1,
              "max_context_bytes": 8192,
              "max_output_bytes": 4096,
              "max_candidates": 1,
              "max_runtime_ms": 1000,
              "max_iterations": null,
              "max_output_tokens": null
            }
          }
        ],
        "search_text": "nearest"
      }
    }
  ],
  "max_concurrent_reasoning": 2
}
