{
  "adapter_id": "workspace.reasoner",
  "producer_class": "adapter",
  "enabled_capabilities": [
    "solution.propose"
  ],
  "granted_permissions": [
    "reason.compute"
  ],
  "assigned_trust": "medium",
  "max_payload_bytes": 4096,
  "max_external_reference_bytes": 256,
  "reasoning_limits_v2": {
    "methods": [
      "rules"
    ],
    "resources": {
      "max_context_items": 8,
      "max_context_bytes": 32768,
      "max_output_bytes": 8192,
      "max_candidates": 1,
      "max_runtime_ms": 1000,
      "max_iterations": 64
    }
  }
}
