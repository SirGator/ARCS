{
  "$id": "arcs.formal_verification_report.v1",
  "title": "ARCS Formaler Prüfbericht",
  "type": "object",
  "required": [
    "statement",
    "toolchain",
    "verdict",
    "allowed_axioms",
    "used_axioms",
    "findings",
    "duration_ms"
  ],
  "properties": {
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "obligation_version": {
      "type": "string",
      "minLength": 1
    },
    "proof_version": {
      "type": "string",
      "minLength": 1
    },
    "request_version": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "plan_revision": {
      "type": "string",
      "minLength": 1
    },
    "toolchain": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "verdict": {
      "type": "string",
      "enum": [
        "proved",
        "disproved",
        "failed",
        "unavailable",
        "rejected"
      ]
    },
    "allowed_axioms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "used_axioms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "verdict",
          "detail"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
