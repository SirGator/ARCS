{
  "$id": "arcs.plan_template_availability.v1",
  "type": "object",
  "required": ["definition_version_id", "input_version_id", "sequence", "revision", "templates"],
  "properties": {
    "definition_version_id": { "type": "string", "minLength": 1 },
    "input_version_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 7 },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "reasoners"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reasoners": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["capability", "method", "availability"],
              "properties": {
                "capability": {
                  "type": "object",
                  "required": ["adapter_id", "capability_id"],
                  "properties": {
                    "adapter_id": { "type": "string", "minLength": 1 },
                    "capability_id": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                },
                "method": { "type": "string", "minLength": 1 },
                "availability": { "type": "string", "enum": ["ready", "busy", "unavailable", "incompatible"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
