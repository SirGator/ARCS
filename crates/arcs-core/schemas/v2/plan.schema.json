{
  "$id": "arcs.plan.v2",
  "type": "object",
  "required": [
    "runtime_id",
    "parent_sequence",
    "parent_route_id",
    "input_version_id",
    "proposal_version_id",
    "steps",
    "revision"
  ],
  "properties": {
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "parent_route_id": {
      "type": "string",
      "minLength": 1
    },
    "input_version_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_version_id": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "template_id",
          "route"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "template_id": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "index"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "previous_plan_version_id": {
          "type": "string",
          "minLength": 1
        },
        "context_version_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
