{
  "$id": "arcs.plan_replanning.v2",
  "type": "object",
  "required": [
    "runtime_id",
    "parent_sequence",
    "input_version_id",
    "revision",
    "previous_plan_version_id",
    "previous_proposal_version_id",
    "steps",
    "context",
    "omitted_output_items"
  ],
  "properties": {
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "input_version_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "previous_plan_version_id": {
      "type": "string",
      "minLength": 1
    },
    "previous_proposal_version_id": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "id",
          "template_id",
          "state",
          "resolution",
          "output_version_ids"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "template_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "failed",
              "ready_for_review",
              "awaiting_approval",
              "completed",
              "blocked",
              "rejected",
              "budget_exhausted",
              "cancelled"
            ]
          },
          "result_version_id": {
            "type": "string",
            "minLength": 1
          },
          "failure_receipt_version_id": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "enum": [
              "waiting",
              "blocked",
              "ready"
            ]
          },
          "output_version_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version_id",
          "payload_fields"
        ],
        "properties": {
          "version_id": {
            "type": "string",
            "minLength": 1
          },
          "payload_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "omitted_output_items": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
